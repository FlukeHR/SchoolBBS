<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bbs.mapper.PostTypeMapper">

    <!-- 插入贴子类型 -->
    <insert id="createPostType" parameterType="com.bbs.entity.PostType">
        INSERT INTO post_type (type_name, creator, create_time, description)
        VALUES (#{typeName}, #{creator}, NOW(), #{description})
    </insert>

    <!-- 删除贴子类型 -->
    <delete id="deletePostType" parameterType="int">
        DELETE FROM post_type WHERE id = #{id}
    </delete>

    <!-- 根据ID查询贴子类型 -->
    <select id="findPostTypeById" parameterType="int" resultType="com.bbs.entity.PostType">
        SELECT * FROM post_type WHERE id = #{id}
    </select>

    <!-- 根据名称查询贴子类型 -->
    <select id="findPostTypeByName" parameterType="string" resultType="com.bbs.entity.PostType">
        SELECT * FROM post_type WHERE type_name = #{typeName}
    </select>

    <!-- 查询所有贴子类型 -->
    <select id="findAllPostTypes" resultType="com.bbs.entity.PostType">
        SELECT * FROM post_type ORDER BY create_time DESC
    </select>

    <!-- 根据创建者查询贴子类型 -->
    <select id="findPostTypesByCreator" parameterType="string" resultType="com.bbs.entity.PostType">
        SELECT * FROM post_type WHERE creator = #{creator} ORDER BY create_time DESC
    </select>

    <!-- 更新贴子类型名称 -->
    <update id="updatePostTypeName" parameterType="com.bbs.entity.PostType">
        UPDATE post_type SET type_name = #{typeName} WHERE id = #{id}
    </update>

</mapper>
