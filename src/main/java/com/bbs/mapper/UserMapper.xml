<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bbs.mapper.UserMapper">

    <!-- 数据库迁移：为user表添加balance字段 -->
    <update id="addBalanceColumn">
        ALTER TABLE user ADD COLUMN balance DECIMAL(10,2) DEFAULT 0.00
    </update>

    <!-- 初始化现有用户的余额为0 -->
    <update id="initUserBalance">
        UPDATE user SET balance = 0.00 WHERE balance IS NULL
    </update>

    <!-- 查询所有用户 -->
    <select id="selectAllUsers" resultType="com.bbs.entity.User">
        SELECT * FROM user
    </select>

    <!-- 根据ID查询用户 -->
    <select id="selectUserById" parameterType="int" resultType="com.bbs.entity.User">
        SELECT * FROM user WHERE uid = #{uid}
    </select>

    <!-- 插入用户 -->
    <insert id="insertUser" parameterType="com.bbs.entity.User" keyProperty="uid">
        INSERT INTO user (uid,name, passwd, sex,rtime)
        VALUES (#{uid},#{name}, #{passwd}, #{sex},NOW())
    </insert>

    <!-- 更新用户 -->
    <update id="updateUser" parameterType="com.bbs.entity.User">
        UPDATE user
        SET name = #{name}, passwd = #{passwd}, sex = #{sex}
        WHERE uid = #{uid}
    </update>

    <!-- 删除用户 -->
    <delete id="deleteUser" parameterType="com.bbs.entity.User">
        DELETE FROM user WHERE uid = #{uid}
    </delete>

    <!-- 通过用户名查询用户 -->
    <select id="findUserByName" parameterType="String" resultType="com.bbs.entity.User">
        SELECT * FROM user WHERE name = #{name}
    </select>

    <!-- 登录校验 -->
    <select id="check" parameterType="String" resultType="com.bbs.entity.User">
        SELECT * FROM user WHERE name = #{param1} AND passwd = #{param2}
    </select>

    <!-- 检查用户名是否存在 -->
    <select id="checkName" parameterType="String" resultType="Boolean">
        SELECT EXISTS(SELECT * FROM user WHERE name = #{name})
    </select>

    <!-- 根据ID查找性别 -->
    <select id="findSexById" parameterType="int" resultType="String">
        SELECT sex FROM user WHERE uid = #{uid}
    </select>

    <!-- 通过用户名查找ID -->
    <select id="findIdByName" parameterType="String" resultType="int">
        SELECT uid FROM user WHERE name = #{name}
    </select>

    <!-- 查询用户余额 -->
    <select id="getUserBalance" parameterType="String" resultType="java.math.BigDecimal">
        SELECT balance FROM user WHERE name = #{username}
    </select>

    <!-- 更新用户余额 -->
    <update id="updateUserBalance">
        UPDATE user SET balance = #{balance} WHERE name = #{username}
    </update>

    <!-- 增加用户余额 -->
    <update id="addUserBalance">
        UPDATE user SET balance = balance + #{amount} WHERE name = #{username}
    </update>

    <!-- 设置用户余额 -->
    <update id="setUserBalance">
        UPDATE user SET balance = #{param2} WHERE name = #{param1}
    </update>

    <!-- 批量更新所有用户余额 -->
    <update id="batchUpdateAllUsersBalance" parameterType="java.math.BigDecimal">
        UPDATE user SET balance = #{balance}
    </update>
</mapper>